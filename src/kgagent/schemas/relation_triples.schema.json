{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Relation Triple Graph",
  "description": "A knowledge graph represented as entity-relation-entity triples using KGFlow format",
  "type": "object",
  "required": ["relations"],
  "properties": {
    "entities": {
      "type": "array",
      "description": "List of all entities extracted from the text",
      "items": {
        "type": "string"
      }
    },
    "relations": {
      "type": "array",
      "description": "List of relation triples",
      "items": {
        "type": "array",
        "minItems": 3,
        "maxItems": 3,
        "items": {
          "type": "string"
        },
        "description": "A triple [subject, relation, object]"
      }
    }
  }
}
