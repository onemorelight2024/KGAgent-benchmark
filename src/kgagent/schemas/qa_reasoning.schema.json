{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "QA Reasoning Result",
  "type": "object",
  "required": ["task_type", "method", "status", "answer"],
  "properties": {
    "task_type": {
      "type": "string",
      "enum": ["qa_reasoning"]
    },
    "method": {
      "type": "string"
    },
    "status": {
      "type": "string"
    },
    "answer": {
      "type": "string"
    },
    "working_dir": {
      "type": "string"
    },
    "summary": {
      "type": "object"
    }
  }
}
